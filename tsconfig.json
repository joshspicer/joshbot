{
	"_comment": [
		"                      __",
		"                     / _)",
		"              .-^^^-/ /",
		"           __/       /",
		"          <__.|_|-|_|",
		"",
		" JoshBot - A dedicated coding assistant great at complex tasks"
	],
	"compilerOptions": {
		"jsx": "react",
		"jsxFactory": "vscpp",
		"jsxFragmentFactory": "vscppf",
		"target": "es2020",
		"module": "commonjs",
		"strict": true,
		"sourceMap": true,
		"outDir": "out",
		"alwaysStrict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"experimentalDecorators": true
	},
	"include": ["src/**/*", "vscode.d.ts", "vscode.proposed.*"]
}